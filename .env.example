# Database Connection:
# - Local dev: Docker Compose postgres service on port 5433 (`docker compose up -d`)
# - Production (Coolify): PostgreSQL service configured in Coolify
DATABASE_URL="postgresql://bugtracker:bugtracker@localhost:5433/bugtracker?schema=public"
# Optional. Prisma Migrate takes a session lock, which a Neon pooler drops.
# Set this to the direct (non-pooler) URL when DATABASE_URL is pooled.
# When unset, a Neon "-pooler" host is rewritten to the direct host for
# migrations only. The running app keeps DATABASE_URL.
# DIRECT_URL=

# Auth.js Secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# (NEXTAUTH_SECRET is read as a fallback name for the same value.)
# NEXTAUTH_SECRET=

# Auth.js Base URL (full auth endpoint, e.g. http://localhost:3001/api/auth):
# Local development (served from root, matching production at ziki.dev):
AUTH_URL="http://localhost:3001/api/auth"
NEXTAUTH_URL="http://localhost:3001/api/auth"
# Production (Coolify). ziki.dev is canonical; the old issues.zedu.chat host
# is still served, so existing links keep working:
# AUTH_URL="https://ziki.dev/api/auth"
# NEXTAUTH_URL="https://ziki.dev/api/auth"
# Legacy sub-path deployment (contributors.zedu.chat/bug-tracker):
# AUTH_URL="https://contributors.zedu.chat/bug-tracker/api/auth"
# NEXTAUTH_URL="https://contributors.zedu.chat/bug-tracker/api/auth"

# Public site URL and sub-path. Both are worked out from AUTH_URL; set them only
# to override. NEXT_PUBLIC_SITE_URL is the canonical origin used in links and
# emails. NEXT_PUBLIC_BASE_PATH (or BASE_PATH) serves the app under a sub-path,
# e.g. "/bug-tracker"; "" or "/" means the root domain.
# NEXT_PUBLIC_SITE_URL="https://ziki.dev"
# NEXT_PUBLIC_BASE_PATH=
# BASE_PATH=

# In production, a loopback AUTH_URL is ignored so emails never point at
# localhost. Set this to "true" only when testing a production build locally.
# SITE_URL_ALLOW_LOOPBACK=

# Email/password sign-in (plus forgot/reset password). Zedu Bugs is Google-only
# in production, so this defaults to OFF when NODE_ENV=production and ON in
# local dev (needed for the demo seed logins). Set "true" / "false" to override.
# AUTH_PASSWORD_LOGIN=

# Optional. Google Form opened by the floating "Report issue" button in the
# bottom-right corner. Only https:// links on Google-owned hosts are accepted
# (docs.google.com, forms.gle); anything else leaves the button hidden.
# REPORT_FORM_URL="https://docs.google.com/forms/d/e/<FORM_ID>/viewform"

# Optional Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI in Google Console:
# https://ziki.dev/api/auth/callback/google
# (Old host, while it is still in use: https://issues.zedu.chat/api/auth/callback/google)
# (Legacy sub-path: https://contributors.zedu.chat/bug-tracker/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Auth.js's own names are accepted as fallbacks for the two values above:
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Google sign-in allowlist (#223). Comma-separated; both may be set at once.
# GOOGLE_ALLOWED_EMAILS: exact addresses (case-insensitive), e.g.
#   GOOGLE_ALLOWED_EMAILS="alice@example.com,bob@example.com"
# GOOGLE_ALLOWED_DOMAINS: domains without the @, e.g.
#   GOOGLE_ALLOWED_DOMAINS="zedu.chat,example.org"
# A Google address is admitted when it matches either list (or is a
# SUPER_ADMIN_EMAIL). With neither variable set every Google account is
# auto-provisioned — the historic behaviour, and a startup warning is logged.
# GOOGLE_ALLOWED_EMAILS=
# GOOGLE_ALLOWED_DOMAINS=


# Super admin email(s). Anyone signing in with one of these addresses is granted
# the super_admin role. Comma-separate several, or use SUPER_ADMIN_EMAILS.
# Nothing is hard-coded: with neither set, nobody is auto-promoted.
SUPER_ADMIN_EMAIL="you@example.com"
SUPER_ADMIN_PASSWORD=
# Several super admins, comma-separated (combined with SUPER_ADMIN_EMAIL):
# SUPER_ADMIN_EMAILS="lead@example.com,ops@example.com"
# SUPER_ADMIN_NAME="Super Admin"
# Set to "true" to rotate password / promote an existing account to super_admin
# SUPER_ADMIN_FORCE_UPDATE=false
# Set to "true" to wipe users/bugs and load demo data (empty DB seeds demo by default)
# SEED_DEMO_DATA=true
# Demo accounts share a known password, so the seed refuses to load them when
# NODE_ENV=production unless this is also "true". Never set it on a real site.
# SEED_DEMO_DATA_IN_PRODUCTION=false
# Production server start awards missing ledger points. Set to 0 to skip that.
# BACKFILL_POINTS_ON_START=0

# GitHub App for merging accepted fixes (#452). The agent platform links a pull
# request to an issue and, once the fix is accepted, merges it through the app
# installation on the project (Row in "Project.githubInstallationId"). No token
# is stored: installation tokens are minted on demand and kept in memory only.
# Create the app under GitHub → Settings → Developer settings → GitHub Apps.
# GITHUB_APP_PRIVATE_KEY is the PEM contents; newlines may be literal "\n".
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# GITHUB_APP_SLUG=your-github-app-slug
# Configure the GitHub App's Setup URL to https://<your-host>/projects/github/callback.
# Project settings send a one-time state value to GitHub and bind the returned
# installation ID to the project. No access token is stored.

# SMTP for password-reset and notification emails (AUTH LOGIN + STARTTLS).
# Development: when unset, emails are printed to the server console.
# Production: required. When unset, "Forgot password" says reset emails aren't
# available and notifications are skipped; nothing is written to the logs.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Zedu Bugs <noreply@example.com>"
# Optional tuning. EHLO name defaults to the host name when it's a full domain,
# else "[127.0.0.1]"; some providers reject anything else. Timeouts are in ms.
# SMTP_EHLO_NAME=mail.example.com
# SMTP_CONNECT_TIMEOUT_MS=10000
# SMTP_COMMAND_TIMEOUT_MS=10000
# Simultaneous SMTP connections when sending notifications (default 2).
# EMAIL_CONCURRENCY is read as a fallback name.
# SMTP_MAX_CONCURRENCY=2
# EMAIL_CONCURRENCY=

# Time zone for dates rendered on the server and in emails. TZ wins when set;
# otherwise DEFAULT_TIMEZONE; otherwise Africa/Lagos.
# DEFAULT_TIMEZONE=Africa/Lagos
# TZ=Africa/Lagos

# Where rate-limit counters live (#296). "postgres" shares them across every
# app instance and survives restarts (needs the RateLimitHit migration);
# "memory" keeps them per process. Unset: postgres in production, memory
# otherwise.
# RATE_LIMIT_STORE=postgres

# Client IP for rate limits (#507, #663, #675). Each proxy in front of the app appends the
# address it saw to X-Forwarded-For, so the client is TRUSTED_PROXY_HOPS entries
# from the right. Traefik/Coolify and Vercel each add one hop (the default).
# Use 2 with a CDN in front of Traefik, or 0 when nothing proxies the app (falls back to connection IP).
# TRUSTED_PROXY_HOPS=1
# Or configure a comma-separated list of trusted proxy IPs/subnets (e.g. 10.0.0.1, 192.168.0.0/16, loopback).
# Requests from untrusted direct connections ignore forged X-Forwarded-For headers
# and use the actual connection IP:
# TRUSTED_PROXIES=
# Or read one header the platform sets and clients can't forge instead:
# CLIENT_IP_HEADER=cf-connecting-ip

# Webhook dispatcher secret — generate with: openssl rand -base64 32
# Used to authenticate scheduler calls to the webhook dispatch endpoint.
# Required for webhook delivery to work.
# WEBHOOK_DISPATCH_SECRET=
# Dispatch runs allowed per minute for each caller (scheduler, cron), 1 to 120.
# Default 12: a run every 10 seconds plus a few extra batches (#679).
# WEBHOOK_DISPATCH_MAX_PER_MINUTE=12

# Claim sweep secret — generate with: openssl rand -base64 32 (#524)
# Used to authenticate scheduler calls to POST /api/v1/claims/dispatch, which
# releases claims whose agent stopped heartbeating (the 15-minute clock) and
# re-offers the reopened issues. Required so silent claims don't hold issues.
# CLAIM_DISPATCH_SECRET=

# Points balance export signing secret (#618) — generate with: openssl rand -base64 32
# HMAC key for a tenant admin's balance snapshot (JSON + CSV): signs the
# snapshot's content hash so a copy can be checked against this server later.
# Required to export; with it unset the export refuses instead of signing with
# a fallback value.
# POINTS_EXPORT_SECRET=
# Encrypts each webhook's signing secret at rest (AES-256-GCM). Required as soon
# as an agent subscribes a webhook: 32 bytes as 64 hex characters, e.g.
#   openssl rand -hex 32
# Keep it stable: changing it makes existing webhook secrets unreadable.
# WEBHOOK_SECRET_KEY=

# Agent platform feature flag (#422). Enabled by default (true). Set to "false"
# to explicitly disable agent registry, pairing, and controls in Settings.
# AGENT_PLATFORM=true
# NEXT_PUBLIC_AGENT_PLATFORM=true

# Vercel Cron and external schedulers call /api/internal/cron and /api/v1/webhooks/dispatch
# with `Authorization: Bearer $CRON_SECRET` (#583, #647).
# Runs offer expiry, stale-claim releases, level promotions, webhook dispatch, and retention prunes.
# Set the same value in the deployment environment so platform sweeps run on schedule.
CRON_SECRET=

# Legacy migration repairs for a stuck database. Normal container starts only run
# `prisma migrate deploy`; set this to 1 for one start to re-run the repair steps (#581).
MIGRATION_REPAIR=

# Container start (#580): in production a migration that still fails after
# scripts/migrate.mjs's repairs stops the container, so the previous one keeps
# serving. Set this to "true" only during an incident, to start anyway.
# ALLOW_START_WITH_FAILED_MIGRATION=false

# Secret for POST /api/github/webhook (#474). Set the same value on the GitHub webhook
# (Pull requests events, application/json) so merged PRs resolve their issues.
GITHUB_WEBHOOK_SECRET=

# Deployed commit shown by GET /api/health (#539). Set automatically by platforms
# like Coolify (SOURCE_COMMIT) or Vercel (VERCEL_GIT_COMMIT_SHA); set GIT_COMMIT
# yourself on other platforms so agents can tell which build is live.
# SOURCE_COMMIT=
# VERCEL_GIT_COMMIT_SHA=
# GIT_COMMIT=

# Draft-to-structured idea conversion agent (#1162, scripts/agents/structure-drafts.ts).
#   ZIKI_AGENT_KEY=<contributor+ level agent key> \
#   ANTHROPIC_API_KEY=<key> \
#     pnpm tsx scripts/agents/structure-drafts.ts [--dry-run]
# ZIKI_AGENT_KEY is also required by the /structure endpoint itself; reusing
# an existing agent key (e.g. a solver already at contributor level) is fine.
# ZIKI_AGENT_KEY=
# ANTHROPIC_API_KEY=
# Ziki origin the agent talks to. Defaults to https://ziki.dev.
# ZIKI_BASE_URL=
# Anthropic model used to extract structured fields from raw draft text.
# Defaults to claude-sonnet-4-5.
# ANTHROPIC_MODEL=
